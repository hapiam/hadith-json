node_modules
package-lock.json
dist
.env

# Local staging output for the hapiam/mirror/hadith archival mirror upload —
# regenerated on demand from db/unified/, not source. See README.md's Layout
# table.
hapiam_mirror_hadith/

# Live working copy for sources/amrayn.com/scripts/scrape_amrayn.dart -- a
# run appends here so its own resume/retry logic can tell "already done" from
# "not yet attempted". Disposable: periodically snapshotted (copied, not
# moved) into a dated, git-tracked sources/amrayn.com/runs/ folder instead.
# See sources/README.md for the full archive convention (applies to every
# scrape source in this repo, not just amrayn.com).
db/scrape_cache/

# Raw hadithunlocked.com download (user-downloaded via browser, not
# scraped by any script here) -- 1.8GB across hadith/quran/tafsir, far too
# large to commit. Regenerate/re-download on demand; any curated output
# derived from it (comparison reports, extracted fields) belongs in a
# normal git-tracked file instead, same as every other source in this repo.
sources/hadithunlocked.com/original_source/
# The zipped form of the same raw download -- 314MB, exceeds GitHub's
# 100MB hard limit outright (confirmed 2026-07-28: a stray `git add -A`
# swept this in and got the whole push rejected, GH001).
sources/hadithunlocked.com.zip